# Fingerprint database (generated)
*.db
*.db.bak
*.sqlite

# Local test recordings / audio samples (not source)
*.m4a
*.wav

# Downloaded subtitles
downloads/

# Vosk STT models (large; download separately per README)
models/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# pip / setuptools packaging artifacts (from pip install -e .)
*.egg-info/
*.egg
.eggs/
.pytest_cache/

# Packaging / build artifacts (generated by build_msix.ps1)
.buildvenv/
build/
dist/
# Ignore auto-generated PyInstaller specs, but keep our hand-authored build spec.
*.spec
!episodesleuth.spec
*.msix
*.pfx
*.cer
Launch_DVD_Identifier.bat
Launch_EpisodeSleuth.bat

# OS / editor
.DS_Store
*.swp

# GUI runtime config (user-specific paths/preferences)
gui_config.json


# Test fixtures are committed even though *.db / *.wav are ignored globally.
!tests/fixtures/
!tests/fixtures/*.db
!tests/fixtures/*.wav
.coverage
